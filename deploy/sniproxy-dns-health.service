[Unit]
Description=SNIProxy runtime DNS group circuit breaker
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /usr/local/lib/sniproxy-managed/dns-health.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=sniproxy-dns-health
RuntimeDirectoryMode=0755
UMask=0022

[Install]
WantedBy=multi-user.target
